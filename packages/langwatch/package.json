{
  "name": "@runlens/langwatch",
  "version": "0.1.0",
  "description": "Run LangWatch Scenario simulations repeatedly with RunLens and analyze their reliability.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@runlens/core": "workspace:*"
  },
  "peerDependencies": {
    "@langwatch/scenario": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@langwatch/scenario": { "optional": true }
  }
}
